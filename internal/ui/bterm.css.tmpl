window.bterm-main { background-color: {{.Background}}; }
window { {{if .UIFont}} font-family: {{.UIFont}};{{end}}{{if .UIFontSize}} font-size: {{.UIFontSize}}pt;{{end}} }
.bterm-tab-active { box-shadow: inset 0 0 0 1px {{.Accent}}; }
.bterm-tab-num { background-color: {{.Accent}}; color: {{.Background}}; border-radius: 5px; padding: 0 5px; font-weight: 700; }
.bterm-toast { background-color: {{.Accent}}; color: {{.Background}}; border-radius: 9px; padding: 7px 12px; }
.bterm-shortcuts-title { font-size: 1.35em; font-weight: 700; }
.bterm-shortcuts-description { color: alpha({{.Foreground}}, 0.62); }
.bterm-about-title { font-size: 1.6em; font-weight: 700; }
.bterm-about-version { color: alpha({{.Foreground}}, 0.62); }
.bterm-shortcut-card { background-color: alpha({{.Foreground}}, 0.05); border: 1px solid alpha({{.Foreground}}, 0.10); border-radius: 10px; padding: 12px; }
.bterm-shortcut-card-title { color: {{.Accent}}; font-weight: 700; margin-bottom: 4px; }
.bterm-shortcut-row { padding: 4px 2px; }
.bterm-shortcut-action { font-weight: 600; }
.bterm-shortcut-key { background-color: alpha({{.Accent}}, 0.16); border: 1px solid alpha({{.Accent}}, 0.32); border-radius: 5px; font-family: monospace; font-size: 0.9em; padding: 2px 5px; }
.bterm-context-row { padding: 4px 8px; }
.bterm-context-row:hover { background-color: alpha({{.Foreground}}, 0.08); }
.bterm-menu-shortcut { font-family: monospace; font-size: 0.82em; color: alpha({{.Foreground}}, 0.58); padding: 0 2px; }
.bterm-memmon { font-family: monospace; font-size: 0.82em; color: alpha({{.Foreground}}, 0.58); padding: 0 6px; }

.bterm-tab-dragging { background-color: alpha({{.Accent}}, 0.18); box-shadow: inset 0 -2px 0 {{.Accent}}; }
button.bterm-tab-dragging { background-color: alpha({{.Accent}}, 0.18); }
